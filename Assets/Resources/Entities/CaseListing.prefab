  m_Script: {fileID: 11500000, guid: b05e981ae95ebd447a7ebdf4f28cb85b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  caseName: case0
  descriptionName: "\u0413\u043E\u043D\u0447\u0430\u0440\u043D\u043E\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E"
  description: "\u0426\u0435\u043D\u0442\u0440 \u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u043F\u0440\u043E\u043C\u044B\u0441\u043B\u043E\u0432 \u0432 \u043E\u0434\u043D\u043E\u043C
    \u0438\u0437 \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043C\u0435\u0441\u0442 \u0440\u0430\u0437\u0432\u0438\u043B\u0441\u044F \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0435
    \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u0438,
    \u043D\u043E \u0435\u0435 \u0441\u0440\u043E\u043A \u043F\u043E\u0434\u043E\u0448\u0435\u043B
    \u043A \u043A\u043E\u043D\u0446\u0443. \u0412 \u0441\u043E\u0441\u0442\u0430\u0432\u0435
    \u0446\u0435\u043D\u0442\u0440\u0430 \u0442\u0440\u0438 \u0433\u043E\u043D\u0447\u0430\u0440\u043D\u044B\u0445
    \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0435, \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0449\u0438\u0435
    \u043C\u0430\u0441\u0442\u0435\u0440-\u043A\u043B\u0430\u0441\u0441\u044B \u0438
    \u043E\u0434\u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u0441\u0443\u0432\u0435\u043D\u0438\u0440\u043D\u0430\u044F \u043F\u0430\u043B\u0430\u0442\u043A\u0430.
    \u0412 \u0446\u0435\u043D\u0442\u0440\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
    8 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432, \u043F\u0440\u043E\u0434\u0430\u0432\u0435\u0446,
    \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440, \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440
    \u0438 8 \u044D\u043A\u0441\u043A\u0443\u0440\u0441\u043E\u0432\u043E\u0434\u043E\u0432."
  IT: 160
  HR: 50
  EC: 50
  BP: 40
