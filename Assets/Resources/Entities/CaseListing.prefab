--- !u!114 &2012996867026278520
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6247638946776163445}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b05e981ae95ebd447a7ebdf4f28cb85b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  caseName: case1
  descriptionName: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F"
  description: "\u041A\u043E\u043C\u043F\u0430\u043D\u0438\u044F-\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
    \u043E\u043A\u043E\u043D\u043D\u044B\u0445 \u0448\u0442\u043E\u0440 \u0438 \u0436\u0430\u043B\u044E\u0437\u0438
    \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u0435\u0442 \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u0435\u043D\u0438\u044F
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u0440\u0438\u0437\u0438\u0441\u0430. \u0412 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0435
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F \u0441\u043A\u043B\u0430\u0434,
    \u0434\u0432\u0430 \u0446\u0435\u0445\u0430 \u0438 \u043E\u0442\u0434\u0435\u043B
    \u043F\u0440\u043E\u0434\u0430\u0436. \u0414\u043B\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438
    \u0441\u043A\u043B\u0430\u0434\u0430. \u0418\u043C\u0435\u0435\u0442\u0441\u044F
    \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442-\u0441\u0430\u0439\u0442 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0438.
    \u041F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0441\u043B\u0443\u0436\u0431\u044B
    \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0438 \u043C\u043E\u043D\u0442\u0430\u0436\u0430."
  IT: 30
  HR: 50
  EC: 80
  BP: 140
