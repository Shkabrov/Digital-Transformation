--- !u!114 &9086251186995099403
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8918099751684803531}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b05e981ae95ebd447a7ebdf4f28cb85b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  caseName: case2
  descriptionName: "\u0413\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439 \u043F\u0430\u0440\u043A"
  description: "\u0412 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C \u043F\u0430\u0440\u043A\u0435
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u043E\u0441\u0435\u043B\u043A\u0430
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F:
    \u044F\u0440\u043C\u0430\u0440\u043A\u0438, \u0432\u044B\u0441\u0442\u0430\u0432\u043A\u0438
    \u0438 \u0442.\u0434. \u041E\u043D\u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0435\u0433\u043E \u0436\u0438\u0442\u0435\u043B\u044F\u043C,
    \u043D\u043E \u0438 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u044B
    \u043D\u0430 \u043F\u0440\u0438\u0435\u0437\u0434 \u043B\u044E\u0434\u0435\u0439
    \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u043E\u0432.
    \u0421\u0435\u0439\u0447\u0430\u0441 \u0432 \u043F\u0430\u0440\u043A\u0435 \u0435\u0441\u0442\u044C
    \u043E\u0434\u0438\u043D \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440,
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0432\u0435\u0434\u0435\u0442\u0441\u044F
    \u0431\u0443\u0445\u0433\u0430\u043B\u0442\u0435\u0440\u0438\u044F. \u0410 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
    \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
    \u0447\u0435\u0440\u0435\u0437 \u043C\u0435\u0441\u0442\u043D\u0443\u044E \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044E."
  IT: 200
  HR: 20
  EC: 10
  BP: 70
